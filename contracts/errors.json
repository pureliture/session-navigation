{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionNavigationErrors",
  "description": "Schema and catalog of standard refusal and error codes emitted by session-navigation engine",
  "type": "object",
  "properties": {
    "error": {
      "type": "string",
      "description": "invalid_keep_lines means the container is not a list. Invalid list entries are ignored per target and returned as keep_lines_ignored with entry and English reason; normalized entries appear in keep_lines_normalized. keep_lines_conflict still protects an already compacted target missing newly requested evidence; Unhide recovers its original rather than silently discarding the new retention requirement.",
      "enum": [
        "not_long",
        "protected_error",
        "sensitive_invocation",
        "invocation_too_large",
        "invalid_invocation_order",
        "ambiguous",
        "content_tampered",
        "pending_full",
        "not_found",
        "already_exists",
        "in_progress",
        "reservation_invalid",
        "invocation_conflict",
        "verification_failed",
        "summarizer_unavailable",
        "input_too_large",
        "invalid_response",
        "db_error",
        "db_full",
        "version_conflict",
        "destructive_command",
        "destructive_check_failed",
        "invalid_version",
        "invalid_params",
        "invalid_session",
        "invalid_snapshot",
        "invalid_record",
        "snapshot_too_large",
        "unconfirmed_snapshot",
        "unknown_method",
        "identity_expired",
        "invalid_action",
        "invalid_keep_lines",
        "invalid_keep_lines_action",
        "keep_lines_conflict",
        "invalid_max_items",
        "invalid_summaries",
        "invalid_tool_call_ids",
        "tool_call_ids_required",
        "already_hidden",
        "invalid_limit",
        "invalid_request",
        "missing_tool_call_id",
        "invalid_invocation",
        "disabled",
        "handler_unavailable",
        "invalid_handler_result",
        "no_recent_list",
        "unknown_display_number",
        "summarize_unsupported",
        "engine_protocol_incompatible",
        "unsafe_journal_mode",
        "adapter_unavailable",
        "invalid_adapter_registration",
        "invalid_target_identity",
        "not_pending"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "policy_refusal",
        "store_capacity",
        "lifecycle",
        "verification",
        "transport"
      ]
    },
    "description": {
      "type": "string"
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "error",
    "category",
    "description",
    "retryable"
  ],
  "additionalProperties": false
}